# Google OAuth (Gmail provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Office 365 / Outlook provider)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Anthropic API (server-side AI features)
ANTHROPIC_API_KEY=

# Encryption key for OAuth tokens stored in KV (AES-256-GCM).
# Accepts a 64-char hex string or any passphrase (hashed to 32 bytes).
ENCRYPTION_KEY=

# Vercel KV (Redis) — token + AI cache storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional override for OAuth redirect base (defaults to http://localhost:3000)
OAUTH_REDIRECT_BASE_URL=
